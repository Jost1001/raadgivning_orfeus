---
import { Image } from "astro:assets";
import logo from "../assets/lysgr├©n-m├©rkgr├©n-cirkel.png";
import facebook from "../assets/facebook.webp";
import instagram from "../assets/insta-1.webp";
import linked from "../assets/linktin.webp";
---

<footer>
  <div>
    <a href="/"> <Image src={logo} alt="Rådgivningen Orfeus logo" /></a>
    <br />
  </div>
  <div>
    <p><strong>Find os</strong></p>
    <a href="/"><Image class="socials-img" src={facebook} alt="Facebook" /><p>Facebook</p></a>
    <a href="/"><Image class="socials-img" src={instagram} alt="Instagram" /><p>Instagram</p></a>
    <a href="/"><Image class="socials-img" src={linked} alt="LinkedIn" /><p>LinkedIn</p></a>
  </div>
  <div>
    <div>
      <p><strong>Vores sider</strong></p>
      <a href="/"><p>Forside</p></a>
      <a href="/more-info"><p>Tilbud</p></a>
      <a href="/contact"><p>Kontakt os</p></a>
      <br />
      <div>
        <p><strong>Kontakt os</strong></p>
        <p>+45 70604657</p>
        <a href="mailto:kontakt@raadgivningen-orfeus.dk"><p>kontakt@raadgivningen-orfeus.dk</p> </a>
        <p>CVR: 46258657</p>
      </div>
    </div>
  </div>

  <style>
    footer {
      display: grid;
      background-color: var(--Dark-green);
      gap: 1.5rem;
      padding: 4rem 2rem;
      color: var(--Background);
      img {
        max-width: 200px;
      }
      a {
        /* font-family: ; */
        color: var(--Background);
        font-weight: 300;
      }
      p {
        color: var(--Tekst);
      }
    }
    .socials-img {
      max-width: 30px;
    }
    @media (min-width: 750px) {
      footer {
        grid-template-columns: 2fr 1fr 1fr;
        padding-top: 6rem;
      }
    }
  </style>

