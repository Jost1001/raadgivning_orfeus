---
const { headline, text } = Astro.props;
---

<header>
  <div>
    <h1>{headline}</h1>
    <p>{text}</p>
  </div>
</header>

<style>
  header {
    width: 100%;
    height: 150px;
    display: flex;
    align-items: center;
  }
  div {
    padding: 0 10%;
  }
  p {
    font-size: larger;
  }
</style>
