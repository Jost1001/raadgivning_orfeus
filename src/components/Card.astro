---
const { headline, tekst, image } = Astro.props;
import { Image } from "astro:assets";
---

<article>
  <a href="/more-info">
    <h3>{headline}</h3>
    {image && <Image src={image} alt={headline} width={200} />}
    <p>{tekst}</p>
  </a>
  <p><a href="/more-info"></a></p>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    background-color: var(--Orange);
    padding: 1.5rem;
    border-radius: 8px;
    max-width: 260px;
  }

  p {
    color: var(--Dark-green);
  }
</style>

