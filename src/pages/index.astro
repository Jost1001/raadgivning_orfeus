---
import "../styles/global.css";

import Card from "../components/Card.astro";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import call from "../assets/headphones_heart.webp";
import mail from "../assets/pc_mail.webp";
import socials from "../assets/socials.webp";
import tabu from "../assets/header-done-1.webp";
import hands from "../assets/helping_hand.webp";
import logo from "../assets/lysgr├©n-m├©rkgr├©n-cirkel.png";
import { Image } from "astro:assets";

// const {title, headline, text} = Astro.props;
---

<!-- ^ hedder fences, og alt der kommer heri hedder frontmatter --><!-- hvis vi skal bruge komponenter lavet i andre filer, så er det her vi skal importere dem ind --><!-- import ____ from "../_____/____" -->
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>Bryd tabuet</title>
  </head>
  <body>
    <nav>
      <div><a href="/"><Image class="logo-img" src={logo} alt="Rådgivningen Orfeus logo" /></a></div>
      <div class="nav-btn">
        <a class="tilbud-btn" href="/more-info">Tilbud</a>
        <a class="contact-btn" href="/contact">Kontakt os</a>
      </div>
    </nav>
    <section class="tabu-img">
      <Image class="bryd" src={tabu} alt="bryd tabuet" />
    </section>

    <a href="/contact">
      <div class="contact-grid">
        <Banner headline="Kontakt os" text="Klik her for at finde vores kontaktoplysninger" />
        <Image class="connection" src={hands} alt="hands reaching out" />
      </div>
    </a>
    <section>
      <h2>Lidt om os</h2>
      <p>Og denne kampagne</p>
      <div class="artikel">
        <p>Hos Rådgivningen Orfeus arbejder vi med rådgivning til folk der er pårørende til folk med et midbrug. Og vi ser dagligt at folk i denne rolle kan have svært ved at se at de også kan have brug for hjælp, rådgivning eller bare en til at lytte. Det er det vi er her for.</p>
        <p>Alle kender til det med at "fint" er det letteste ord vi har til at beskrive vores egen situation.</p>
        <p>Alle kender nok også til at befinde sig i en situation, hvor man tænker at der sikkert er andre der har det sværere end en selv. Denne tankegang kan gøre det svært at søge hjælp, og det vil vi gerne gøre noget ved.</p>
        <p>Derfor har vi lavet denne kampagneside, hvor vores fokus netop vil være på at bryde tabuet om at tale om det at være pårørende. Vi vil gerne prøve at gøre det til et mere alment omtalt emne, så der er flere der kan opdage at de måske har brug for at tale med nogen, eller indse at man ikke behøver at være den der har det sværest.</p>
      </div>
    </section>
    <section>
      <h2>Læs mere her om vores tilbud til dig som pårørende</h2>
      <div class="card-grid">
        <Card headline="Rådgivningens telefon" tekst="Lad os tage en snak om det der trykker." image={call} />
        <Card headline="Individuelt forløb" tekst="Del i et fortroligt rum, det der fylder i tankerne og livet." image={mail} />
        <Card headline="Gruppeforløb" tekst="For dig der kan føle dig ensom, og som mangler andre mennesker at spejles i." image={socials} />
      </div>
    </section>
    <Footer />
  </body>
</html>

<style>
  section {
    padding-inline: 10%;
    padding-block: 6%;
  }

  .card-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    padding-top: 10px;
  }

  .artikel {
    padding-top: 10px;
    column-count: 2;
  }
  .bryd {
    width: 100%;
    max-width: 1200px;
  }
  .tabu-img {
    padding: 0;
  }
  .logo {
    width: 10%;
  }
  .logo-img {
    max-width: 70px;
    margin-left: 15px;
  }
  .connection {
    width: 50%;
    margin-left: 30%;
  }
</style>
