---
import "../styles/global.css";

import Card from "../components/Card.astro";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import call from "../assets/headphones_heart.webp";
import mail from "../assets/pc_mail.webp";
import socials from "../assets/socials.webp";

// const {title, headline, text} = Astro.props;
---

<!-- ^ hedder fences, og alt der kommer heri hedder frontmatter --><!-- hvis vi skal bruge komponenter lavet i andre filer, så er det her vi skal importere dem ind --><!-- import ____ from "../_____/____" -->
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>Rådgivning Orfeus</title>
  </head>
  <body>
    <nav>
      <div>logo</div>
      <div class="nav-btn">
        <a class="tilbud-btn" href="/more-info">Tilbud</a>
        <a class="contact-btn" href="/contact">Kontakt os</a>
      </div>
    </nav>
    <section>
      <p>her kommer der et fantastisk billede</p>
    </section>

    <a href="/contact">
      <div>
        <Banner headline="Kontakt os" text="Klik her for at finde vores kontaktoplysninger" image={call} />
      </div>
    </a>
    <section>
      <h2>Lidt om os</h2>
      <p>måske videoen?</p>
      <div class="artikel">
        <p>blablablablablabla blablablablablablablabla</p>
        <p>blablablabla blablablablablblablabla blablablablablablablablablabla blablablabla</p>
        <p>blablablablabla blablablablabla blablablablablablablablablabla blablablablabla</p>
      </div>
    </section>
    <section>
      <h2>Læs mere her om vores tilbud til dig som pårørende</h2>
      <div class="card-grid">
        <Card headline="Overskrift 1" tekst="Fyldetekst" image={call} />
        <Card headline="Overskrift 2" tekst="Fyldetekst" image={mail} />
        <Card headline="Overskrift 3" tekst="Fyldetekst" image={socials} />
      </div>
    </section>
  </body>
  <Footer />
</html>

<style>
  section {
    padding: 10%;
  }

  .card-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    padding-top: 10px;
  }

  .artikel {
    padding-top: 10px;
    column-count: 2;
  }
</style>
